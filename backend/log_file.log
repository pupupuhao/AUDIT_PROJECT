"icon":"CheckCircleOutlined","path":"/main/business/rule","type":1,"component":"rule-center/rule/rule","pid":10,"identifier":"compliance:rule:view","api":"/api/compliance/rules","method":"GET","children":[{"id":222,"status":1,"created":"2026-04-16T07:50:44.372360Z","modified":"2026-04-17T06:24:11.022068Z","name":"新增规则","icon":null,"path":null,"type":2,"component":null,"pid":12,"identifier":"compliance:rule:create","api":"/api/compliance/rules","method":"POST"},{"id":223,"status":1,"created":"2026-04-16T07:50:44.372360Z","modified":"2026-04-17T06:24:11.022068Z","name":"编辑规则","icon":null,"path":null,"type":2,"component":null,"pid":12,"identifier":"compliance:rule:update","api":"/api/compliance/rules/{rule_id}","method":"PUT"},{"id":224,"status":1,"created":"2026-04-16T07:50:44.372360Z","modified":"2026-04-17T06:24:11.022068Z","name":"删除规则","icon":null,"path":null,"type":2,"component":null,"pid":12,"identifier":"compliance:rule:delete","api":"/api/compliance/rules/{rule_id}","method":"DELETE"},{"id":221,"status":1,"created":"2026-04-16T09:07:37.741753Z","modified":"2026-04-17T06:24:11.022068Z","name":"刷新规则缓存","icon":null,"path":null,"type":3,"component":null,"pid":12,"identifier":null,"api":"/api/compliance/rules/refresh","method":"GET"},{"id":13,"status":1,"created":"2026-04-08T08:37:44.993827Z","modified":"2026-04-17T06:24:11.022068Z","name":"规则检索","icon":null,"path":null,"type":3,"component":null,"pid":12,"identifier":null,"api":"/api/compliance/rules/search","method":"POST"}]},{"id":11,"status":1,"created":"2026-04-08T08:37:44.993827Z","modified":"2026-04-17T06:24:11.022068Z","name":"法律文件库管理","icon":"DatabaseOutlined","path":"/main/business/law","type":1,"component":"rule-center/law/law","pid":10,"identifier":"compliance:law:view","api":"/api/compliance/laws","method":"GET","children":[{"id":211,"status":1,"created":"2026-04-16T06:42:07.424027Z","modified":"2026-04-17T06:24:11.022068Z","name":"法规条款查询","icon":null,"path":null,"type":3,"component":null,"pid":11,"iden