 {"code":200,"data":[{"id":1,"status":1,"created":"2026-04-08T08:37:44.993827Z","modified":"2026-04-08T08:37:44.993827Z","name":"系统管理","icon":"SettingOutlined","path":"/main/system","type":0,"component":null,"pid":0,"identifier":null,"api":null,"method":null,"children":[{"id":2,"status":1,"created":"2026-04-08T08:37:44.993827Z","modified":"2026-04-08T08:37:44.993827Z","name":"用户管理","icon":"UserOutlined","path":"/main/system/user","type":1,"component":"user/user","pid":1,"identifier":null,"api":"/api/system/user","method":"GET","children":[{"id":101,"status":1,"created":"2026-04-08T10:22:33.358711Z","modified":"2026-04-08T10:22:33.358711Z","name":"新增用户","icon":null,"path":null,"type":2,"component":null,"pid":2,"identifier":"user:create","api":"/api/system/user","method":"POST"},{"id":102,"status":1,"created":"2026-04-08T10:22:33.358711Z","modified":"2026-04-08T10:22:33.358711Z","name":"编辑用户","icon":null,"path":null,"type":2,"component":null,"pid":2,"identifier":"user:update","api":"/api/system/user/{pk}","method":"PUT"},{"id":103,"status":1,"created":"2026-04-08T10:22:33.358711Z","modified":"2026-04-08T10:22:33.358711Z","name":"删除用户","icon":null,"path":null,"type":2,"component":null,"pid":2,"identifier":"user:delete","api":"/api/system/user/{pk}","method":"DELETE"}]},{"id":3,"status":1,"created":"2026-04-08T08:37:44.993827Z","modified":"2026-04-08T08:37:44.993827Z","name":"角色管理","icon":"TeamOutlined","path":"/main/system/role","type":1,"component":"role/role","pid":1,"identifier":null,"api":"/api/system/role","method":"GET","children":[{"id":111,"status":1,"created":"2026-04-08T10:22:33.358711Z","modified":"2026-04-08T10:22:33.358711Z","name":"新增角色","icon":null,"path":null,"type":2,"component":null,"pid":3,"identifier":"role:create","api":"/api/system/role","method":"POST"},{"id":112,"status":1,"created":"2026-04-08T10:22:33.358711Z","modified":"2026-04-08T10:22:33.358711Z","name":"编辑角色","icon":null,"path":null,"type":2,"component":null,"pid":3,"identifier":"role:upd