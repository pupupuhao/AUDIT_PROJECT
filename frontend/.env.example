# Current system frontend request base
VITE_BASE_URL=/api

# Current system backend websocket endpoint
VITE_WS=ws://localhost:8001/api/system/ws

# Local dev proxy target for the current system backend
VITE_PROXY_TARGET=http://localhost:8001

